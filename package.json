{
  "name": "rxjs-testing-utility",
  "version": "0.1.0",
  "description": "Testing utilities for RxJS observables with timeline recording and visualization",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest --config ./jest.config.json",
    "test:watch": "jest --watch --config ./jest.config.json",
    "test:update": "jest -u --config ./jest.config.json"
  },
  "devDependencies": {
    "@types/jest": "^19.2.2",
    "jest": "^19.0.2",
    "jest-environment-node-debug": "^2.0.0",
    "rxjs": "^5.3.0",
    "ts-jest": "^19.0.10",
    "ts-node": "^3.0.2",
    "typescript": "2.2"
  }
}
